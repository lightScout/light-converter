---
/* Living background. mode="hero" adds the quasar behind the headline; "ambient" is sky + mist only. */
interface Props { mode?: 'hero' | 'ambient'; centerY?: number; class?: string }
const { mode = 'ambient', centerY = 0.6, class: cls = '' } = Astro.props;
---
<canvas class={`scene ${cls}`} data-mode={mode} data-center={centerY} aria-hidden="true"></canvas>
<script>
  const canvas = document.querySelector('canvas.scene') as HTMLCanvasElement | null;
  if (canvas) {
    const go = async () => {
      const { mountQuasar } = await import('../islands/quasar');
      mountQuasar(canvas, { mode: (canvas.dataset.mode as 'hero' | 'ambient') || 'ambient', centerY: Number(canvas.dataset.center || 0.6) });
      canvas.classList.add('is-live');
    };
    if ('requestIdleCallback' in window) (window as any).requestIdleCallback(go, { timeout: 800 }); else setTimeout(go, 50);
  }
</script>
<style>
  .scene {
    position: fixed; inset: 0; width: 100%; height: 100%;
    z-index: -1; pointer-events: none;
    opacity: 0; transition: opacity 1600ms ease;
    background:
      radial-gradient(80% 30% at 50% 70%, rgba(241, 213, 155, 0.08), transparent 70%),
      linear-gradient(180deg, #070a1e 0%, #121a3d 60%, #26305e 100%);
  }
  .scene.is-live { opacity: 1; }
</style>
