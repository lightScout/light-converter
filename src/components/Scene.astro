---
/* Living background for the app: the same void as the landing — haze, motes, light ribbons — and on some pages the cut-out card at the side. */
interface Props { mode?: 'hero' | 'ambient'; variant?: 'hero' | 'valley' | 'cloudsea' | 'night' | 'aurora' | 'still' | 'prism'; class?: string }
const { variant = 'valley', class: cls = '' } = Astro.props;
---
<canvas class={`scene ${cls}`} data-variant={variant} aria-hidden="true"></canvas>
<script>
  const canvas = document.querySelector('canvas.scene') as HTMLCanvasElement | null;
  if (canvas) {
    const go = async () => {
      const { mountHero } = await import('../islands/hero3d');
      mountHero(canvas, { ambient: true, variant: canvas.dataset.variant as any });
      canvas.classList.add('is-live');
    };
    if ('requestIdleCallback' in window) (window as any).requestIdleCallback(go, { timeout: 800 }); else setTimeout(go, 50);
  }
</script>
<style>
  .scene { position: fixed; inset: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; opacity: 0; transition: opacity 1600ms ease; background: var(--base); }
  .scene.is-live { opacity: 1; }
</style>
