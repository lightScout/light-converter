---
import Base from './Base.astro';
import Star from '../components/Star.astro';
import Spot from '../components/Spot.astro';
import Scene from '../components/Scene.astro';

interface Props { title?: string; active: 'home' | 'batches' | 'light' | 'settings'; scene?: 'valley' | 'cloudsea' | 'night' | 'aurora' | 'still' | 'prism' }
const { title, active, scene } = Astro.props;
const variant = scene ?? ({ home: 'valley', batches: 'night', light: 'aurora', settings: 'still' } as const)[active];

const items = [
  { id: 'home', label: 'Home', href: '/app' },
  { id: 'batches', label: 'Batches', href: '/app/batches' },
  { id: 'light', label: 'Light', href: '/app/light' },
  { id: 'settings', label: 'Settings', href: '/app/settings' },
] as const;
---
<Base title={title ? `${title} — Light Converter` : 'Light Converter'}>
  <div class="app">
    <Scene mode="ambient" variant={variant} />

    <aside class="rail" aria-label="Main">
      <a href="/app" class="brand">
        <Star size={18} color="var(--lavender)" />
        <span class="label">LIGHT CONVERTER</span>
      </a>

      <nav>
        {items.map(it => (
          <a href={it.href} class:list={['item', { active: it.id === active }]} aria-current={it.id === active ? 'page' : undefined}>
            <span class="icon" aria-hidden="true">
              {it.id === 'home' && <svg viewBox="0 0 20 20"><path d="M4 9.5 10 4.5l6 5V16H4z" /></svg>}
              {it.id === 'batches' && <svg viewBox="0 0 20 20"><rect x="4" y="4" width="12" height="12" rx="3" /></svg>}
              {it.id === 'light' && <Star size={16} color="currentColor" />}
              {it.id === 'settings' && <svg viewBox="0 0 20 20"><circle cx="10" cy="10" r="6" /><circle cx="10" cy="10" r="2" /></svg>}
            </span>
            <span class="label">{it.label}</span>
          </a>
        ))}
      </nav>

      <a href="/app/light" class="user">
        <span class="avatar" aria-hidden="true"></span>
        <span class="label who">
          <span class="name">Juan</span>
          <span class="mono gold bal">128 Light</span>
        </span>
        <span class="mono gold bal-mini">128</span>
      </a>
    </aside>

    <main class="content">
      <slot />
    </main>
    <Spot />
  </div>
</Base>

<style>
  .app { position: relative; min-height: 100svh; isolation: isolate; }

  .rail {
    position: fixed; inset: 0 auto 0 0;
    width: var(--rail);
    display: flex; flex-direction: column;
    padding: 24px 0;
    background: color-mix(in srgb, var(--base-2) 80%, transparent);
    backdrop-filter: blur(14px);
    border-right: 1px solid rgba(255, 255, 255, 0.06);
    overflow: hidden;
    z-index: 10;
    transition: width 220ms var(--ease);
  }
  .rail:hover, .rail:focus-within { width: var(--rail-open); }

  .label {
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 160ms ease 40ms, transform 220ms var(--ease) 40ms;
  }
  .rail:hover .label, .rail:focus-within .label { opacity: 1; transform: none; transition-delay: 80ms; }

  .brand {
    display: flex; align-items: center; gap: 14px;
    height: 36px; padding: 0 27px;
    font-size: 12px; font-weight: 600; letter-spacing: 0.2em;
  }
  .brand :global(svg) { flex: none; }

  nav { display: grid; gap: 8px; margin-top: 44px; padding: 0 16px; }
  .item {
    display: flex; align-items: center; gap: 14px;
    height: 40px; padding: 0 11px;
    border-radius: 10px;
    color: var(--muted);
    transition: color 200ms, background 200ms;
  }
  .item:hover { color: var(--text); }
  .item.active {
    color: var(--text);
    background: color-mix(in srgb, var(--glass) 80%, transparent);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14), 0 0 24px rgba(var(--glow), 0.06);
  }
  .item.active .icon { filter: drop-shadow(0 0 6px rgba(var(--glow), 0.6)); }
  .brand :global(svg) { filter: drop-shadow(0 0 8px rgba(var(--glow), 0.55)); }
  .icon { width: 18px; height: 18px; flex: none; display: grid; place-items: center; }
  .icon svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.5; }

  .user {
    margin-top: auto;
    display: flex; align-items: center; gap: 14px;
    padding: 0 20px;
    position: relative;
  }
  .avatar {
    width: 32px; height: 32px; border-radius: 50%; flex: none;
    background: linear-gradient(160deg, #7c8af6, #1b2554);
  }
  .who { display: grid; line-height: 1.3; }
  .name { font-size: 14px; font-weight: 500; }
  .bal { font-size: 12px; }
  .bal-mini {
    position: absolute; left: 0; right: 0; top: 40px;
    text-align: center; font-size: 11px;
    transition: opacity 120ms;
  }
  .rail:hover .bal-mini, .rail:focus-within .bal-mini { opacity: 0; }

  .content {
    margin-left: var(--rail);
    min-height: 100svh;
    padding: 96px 96px 64px 228px;
  }
  @media (max-width: 1100px) { .content { padding: 72px 40px 48px 64px; } }
</style>
