---
import Base from './Base.astro';
import Star from '../components/Star.astro';
import Spot from '../components/Spot.astro';
import Scene from '../components/Scene.astro';
import Frame from '../components/Frame.astro';

interface Props { title?: string; active: 'home' | 'batches' | 'light' | 'settings'; scene?: 'valley' | 'cloudsea' | 'night' | 'aurora' | 'still' | 'prism'; status?: string }
const { title, active, scene, status = 'Drop images anywhere' } = Astro.props;
const variant = scene ?? ({ home: 'valley', batches: 'night', light: 'aurora', settings: 'still' } as const)[active];

const items = [
  { id: 'home', label: 'Home', href: '/app' },
  { id: 'batches', label: 'Batches', href: '/app/batches' },
  { id: 'light', label: 'Light', href: '/app/light' },
  { id: 'settings', label: 'Settings', href: '/app/settings' },
] as const;
---
<Base title={title ? `${title} — Light Converter` : 'Light Converter'}>
  <div class="app">
    <Scene mode="ambient" variant={variant} />
    <Frame />

    <header class="hud top">
      <a href="/app" class="brand"><Star size={16} color="var(--lavender)" /><span class="label" data-scramble>Light Converter</span></a>
      <span class="label dim" data-scramble>{title ?? 'Home'}</span>
    </header>

    <aside class="rail" aria-label="Main">
      <nav class="icons">
        {items.map(it => (
          <a href={it.href} class:list={['item', { active: it.id === active }]} aria-current={it.id === active ? 'page' : undefined}>
            <span class="icon" aria-hidden="true">
              {it.id === 'home' && <svg viewBox="0 0 20 20"><path d="M4 9.5 10 4.5l6 5V16H4z" /></svg>}
              {it.id === 'batches' && <svg viewBox="0 0 20 20"><rect x="4" y="4" width="12" height="12" rx="2" /></svg>}
              {it.id === 'light' && <Star size={16} color="currentColor" />}
              {it.id === 'settings' && <svg viewBox="0 0 20 20"><circle cx="10" cy="10" r="6" /><circle cx="10" cy="10" r="2" /></svg>}
            </span>
            <span class="label lbl">{it.label}</span>
          </a>
        ))}
      </nav>
      <a href="/app/light" class="user">
        <span class="avatar" aria-hidden="true"></span>
        <span class="lbl who"><span class="label">Juan</span><span class="label gold">128 Light</span></span>
      </a>
    </aside>

    <main class="content">
      <slot />
    </main>

    <footer class="hud bottom cells">
      <span class="label gold" data-scramble>128 Light</span>
      <span class="grow"><span class="label dim" id="status" data-scramble>{status}</span></span>
      <span class="label dim" data-scramble>WebGPU · on device</span>
    </footer>
    <Spot />
  </div>
</Base>

<script>
  import { scrambleAll } from '../lib/scramble';
  document.addEventListener('astro:page-load', () => {
    scrambleAll(document, 30);
    // load the model once, early — it lives in a worker that survives page swaps
    if (location.pathname.startsWith('/app')) import('../lib/remover').then(m => m.warmUp().catch(() => {}));
  });
</script>

<style>
  .app { position: relative; min-height: 100svh; isolation: isolate; }
  .hud { position: fixed; z-index: 6; }
  .top { top: 32px; left: 44px; right: 44px; display: flex; align-items: center; justify-content: space-between; pointer-events: none; }
  .top a { pointer-events: auto; }
  .brand { display: inline-flex; align-items: center; gap: 10px; }
  .brand .label { letter-spacing: 0.22em; font-weight: 600; }
  .brand :global(svg) { filter: drop-shadow(0 0 8px rgba(var(--glow), 0.6)); }
  .bottom { left: 15px; right: 15px; bottom: 15px; color: var(--muted); background: rgba(3, 10, 24, 0.55); backdrop-filter: blur(10px); }

  /* Rail: icons only; hovering widens it and the labels slide in beside the icons. Content does not reflow. */
  .rail {
    position: fixed; left: 15px; top: 15px; bottom: 79px; width: var(--rail); z-index: 8;
    display: flex; flex-direction: column; justify-content: center;
    overflow: hidden;
    transition: width 220ms var(--ease), background 220ms;
  }
  .rail:hover, .rail:focus-within { width: var(--rail-open); background: rgba(3, 10, 24, 0.55); backdrop-filter: blur(12px); }
  .icons { display: grid; gap: 6px; padding: 0 18px; }
  .item { display: flex; align-items: center; gap: 14px; height: 36px; padding: 0 9px; color: var(--dim); transition: color 200ms; white-space: nowrap; }
  .item:hover, .item.active { color: var(--text); }
  .item.active .icon { filter: drop-shadow(0 0 6px rgba(var(--glow), 0.7)); }
  .icon { width: 18px; height: 18px; flex: none; display: grid; place-items: center; }
  .icon svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.5; }
  .lbl { opacity: 0; transform: translateX(-6px); transition: opacity 160ms ease, transform 220ms var(--ease); }
  .rail:hover .lbl, .rail:focus-within .lbl { opacity: 1; transform: none; transition-delay: 80ms; }
  .user { position: absolute; left: 0; right: 0; bottom: 24px; display: flex; align-items: center; gap: 14px; padding: 0 27px; white-space: nowrap; }
  .avatar { width: 18px; height: 18px; border-radius: 50%; flex: none; background: linear-gradient(160deg, #e9ecf7, #4a5f8a); }
  .who { display: grid; line-height: 1.5; }

  .content { margin-left: var(--rail); min-height: 100svh; padding: 110px 96px 110px 200px; }
  @media (max-width: 1100px) { .content { padding: 96px 40px 96px 96px; } }
</style>
