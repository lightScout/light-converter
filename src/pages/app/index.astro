---
import App from '../../layouts/App.astro';
import DropZone from '../../islands/DropZone.svelte';
import Recent from '../../islands/Recent.svelte';
---
<App active="home" title="Home">
  <section class="hero">
    <h1>
      <span class="display line-1">Lift the subject.</span>
      <span class="accent line-2">Keep the light.</span>
    </h1>
    <p class="muted lead">Drop images. Get clean cutouts. Pay only for the ones that work.</p>
    <DropZone client:load />
  </section>
  <Recent client:load />
</App>

<style>
  .hero { padding-top: 12vh; }
  h1 { display: grid; gap: 6px; }
  .line-1 { font-size: 64px; }
  .line-2 { font-size: 70px; line-height: 1; padding-bottom: 0.2em; margin-bottom: -0.2em; }
  .lead { margin-top: 28px; font-size: 17px; }
</style>
