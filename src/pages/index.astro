---
import Base from '../layouts/Base.astro';
import Star from '../components/Star.astro';
import DropZone from '../islands/DropZone.svelte';
import Spot from '../components/Spot.astro';
import Scene from '../components/Scene.astro';
---
<Base>
  <main class="hero">
    <Scene mode="hero" centerY={0.6} class="hero-scene" />

    <header class="nav">
      <a href="/" class="brand"><Star size={18} color="var(--lavender)" /><span>LIGHT CONVERTER</span></a>
      <nav>
        <a href="/pricing">Pricing</a>
        <a href="/app">Sign in</a>
      </nav>
    </header>

    <section class="copy">
      <h1>
        <span class="display line-1">Lift the subject.</span>
        <span class="accent line-2">Keep the light.</span>
      </h1>
      <p class="muted lead">Clean cutouts, one image or a hundred. Pay only for the ones that work.</p>
      <DropZone client:load label="Drop images to try" />
      <p class="muted fine">3 free · no account · no watermark</p>
    </section>
    <Spot />
  </main>
</Base>


<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    isolation: isolate;
  }
  .hero {
    /* CSS fallback sky while the scene loads or if WebGL is unavailable */
    background:
      radial-gradient(60% 30% at 50% 44%, rgba(238, 240, 251, 0.16), transparent 70%),
      radial-gradient(80% 30% at 50% 62%, rgba(243, 225, 184, 0.10), transparent 70%),
      linear-gradient(180deg, #0a0b12 0%, #1a1c28 55%, #5b5f72 100%);
  }

  /* Title alive: a slow beam crossing the serif line, and a breathing bloom */
  .line-2 {
    background-image: linear-gradient(100deg,
      var(--lavender) 0%, var(--lavender) 42%,
      #ffffff 50%,
      var(--lavender) 58%, var(--lavender) 100%);
    background-size: 260% 100%;
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; color: transparent;
    animation: title-beam 7s ease-in-out infinite, title-breathe 6s ease-in-out infinite;
  }
  @keyframes title-beam { 0%, 35% { background-position: 110% 0; } 65%, 100% { background-position: -10% 0; } }
  @keyframes title-breathe {
    0%, 100% { filter: drop-shadow(0 0 18px rgba(var(--glow), 0.25)) drop-shadow(0 0 60px rgba(var(--glow), 0.14)); }
    50%      { filter: drop-shadow(0 0 30px rgba(var(--glow), 0.45)) drop-shadow(0 0 90px rgba(var(--glow), 0.24)); }
  }
  .line-1 { animation: title-breathe-soft 6s ease-in-out infinite; }
  @keyframes title-breathe-soft {
    0%, 100% { text-shadow: 0 0 24px rgba(var(--glow), 0.12); }
    50%      { text-shadow: 0 0 40px rgba(var(--glow), 0.28); }
  }
  @media (prefers-reduced-motion: reduce) { .line-1, .line-2 { animation: none; } }

  .nav {
    position: relative; z-index: 2;
    display: flex; align-items: center; justify-content: space-between;
    padding: 28px 64px;
  }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-size: 12px; font-weight: 600; letter-spacing: 0.2em; }
  nav { display: flex; gap: 40px; font-size: 14px; color: var(--muted); }
  nav a { transition: color 200ms; }
  nav a:hover { color: var(--text); }

  .copy {
    position: relative; z-index: 1;
    display: grid; justify-items: center; align-content: center;
    text-align: center;
    padding: 0 24px 18vh;
  }
  h1 { display: grid; gap: 4px; }
  .line-1 { font-size: clamp(48px, 7.2vw, 88px); }
  .line-2 { font-size: clamp(54px, 8vw, 96px); line-height: 1; padding: 0.06em 0.12em 0.22em; margin: -0.06em -0.12em -0.22em; }
  .lead { margin-top: 32px; font-size: 18px; max-width: 60ch; text-shadow: 0 1px 14px rgba(10, 12, 21, 0.7); }
  .fine { margin-top: 20px; font-size: 13px; text-shadow: 0 1px 10px rgba(10, 12, 21, 0.7); }
  .copy :global(.wrap) { text-shadow: 0 1px 14px rgba(10, 12, 21, 0.6); }
  .copy :global(.hint) { color: var(--muted); opacity: 0.85; }
</style>
