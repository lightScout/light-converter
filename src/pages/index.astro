---
import Base from '../layouts/Base.astro';
import Star from '../components/Star.astro';
import Frame from '../components/Frame.astro';
import DropZone from '../islands/DropZone.svelte';
import Spot from '../components/Spot.astro';

const beats = [
  { id: 'lift', label: 'Lift', h1: 'Lift the subject.', h2: 'Keep the light.', p: 'Clean cutouts, one image or a hundred. Pay only for the ones that work.' },
  { id: 'keep', label: 'Keep', h1: 'Nothing leaves', h2: 'your device.', p: 'The free tier runs the model on your own GPU. Your photos stay yours.' },
  { id: 'light', label: 'Free', h1: 'Free, with ads.', h2: 'Or on Light.', p: 'Every cutout is free, no account, no watermark. Light removes the ads and adds server power.' },
];
---
<Base>
  <div class="stage">
    <canvas class="hero3d" id="hero3d" aria-hidden="true"></canvas>
    <Frame />

    <header class="hud top">
      <a href="/" class="brand"><Star size={16} color="var(--lavender)" /><span class="label" data-scramble>Light Converter</span></a>
      <nav>
        <a class="label" href="/pricing" data-scramble>Pricing</a>
        <a class="label" href="/app" data-scramble>Sign in</a>
        <a href="/app" class="bevel"><i class="glyph"></i><span data-scramble>Open app</span></a>
      </nav>
    </header>

    <aside class="hud index" aria-label="Sections">
      {beats.map((b, i) => <a class="label sq" href={`#${b.id}`} data-i={i} class:list={[{ on: i === 0 }]} data-scramble>{b.label}</a>)}
    </aside>

    <footer class="hud bottom cells">
      <span class="label dim" data-scramble>Free with ads · no account · no watermark</span>
      <span class="grow"><i class="fill" id="fill"></i><span class="label scroll"><i></i><span data-scramble>Scroll to explore</span></span></span>
      <span class="label dim" data-scramble>WebGPU · on device</span>
    </footer>

    <section class="copy" id="copy">
      {beats.map((b, i) => (
        <article id={b.id} class:list={['beat', { on: i === 0 }]} data-i={i}>
          <h1>
            <span class="display line-1">{b.h1}</span>
            <span class="accent line-2">{b.h2}</span>
          </h1>
          <p class="muted lead">{b.p}</p>
          {i === 0 && <DropZone client:load label="Drop images to try" />}
          {i === 2 && <a class="bevel light" href="/pricing"><i class="glyph"></i>See plans</a>}
        </article>
      ))}
    </section>
    <Spot />
  </div>
  <div class="track" aria-hidden="true"></div>
</Base>

<script>
  import { scrambleAll } from '../lib/scramble';
  let dispose: (() => void) | null = null;
  let offScroll: (() => void) | null = null;
  const boot = () => {
    const canvas = document.getElementById('hero3d') as HTMLCanvasElement | null;
    if (!canvas) return;
    import('../islands/hero3d').then(({ mountHero }) => { dispose = mountHero(canvas); canvas.classList.add('is-live'); });
    scrambleAll(document, 30);
    const beats = [...document.querySelectorAll<HTMLElement>('.beat')];
    const idx = [...document.querySelectorAll<HTMLElement>('.index a')];
    const fill = document.getElementById('fill')!;
    const hint = document.querySelector<HTMLElement>('.scroll')!;
    let cur = 0;
    const update = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      const p = max > 0 ? scrollY / max : 0;
      fill.style.transform = `scaleX(${p})`;
      hint.style.opacity = String(Math.max(0, 1 - p * 6));
      const i = Math.min(beats.length - 1, Math.round(p * (beats.length - 1)));
      if (i !== cur) { beats[cur].classList.remove('on'); idx[cur].classList.remove('on'); cur = i; beats[cur].classList.add('on'); idx[cur].classList.add('on'); }
    };
    addEventListener('scroll', update, { passive: true });
    offScroll = () => removeEventListener('scroll', update);
    idx.forEach(a => a.addEventListener('click', (e) => { e.preventDefault(); const i = Number(a.dataset.i); const max = document.documentElement.scrollHeight - innerHeight; scrollTo({ top: Math.round((i / (beats.length - 1)) * max), behavior: 'smooth' }); }));
  };
  document.addEventListener('astro:page-load', boot);
  document.addEventListener('astro:before-swap', () => { dispose?.(); dispose = null; offScroll?.(); offScroll = null; });
</script>

<style>
  .track { height: 220vh; }
  .stage { position: fixed; inset: 0; overflow: hidden; isolation: isolate; background: var(--base); }
  .hero3d { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 1400ms ease; }
  .hero3d.is-live { opacity: 1; }

  .hud { position: absolute; z-index: 3; }
  .top { top: 32px; left: 44px; right: 32px; display: flex; align-items: center; justify-content: space-between; }
  .brand { display: inline-flex; align-items: center; gap: 10px; }
  .brand .label { letter-spacing: 0.22em; font-weight: 600; }
  .brand :global(svg) { filter: drop-shadow(0 0 8px rgba(var(--glow), 0.6)); }
  .top nav { display: flex; gap: 26px; align-items: center; color: var(--muted); }
  .top nav a { transition: color 200ms; }
  .top nav a:hover { color: var(--text); }
  .top nav .bevel { margin-left: 8px; }

  .index { left: 44px; top: 50%; transform: translateY(-50%); display: grid; gap: 14px; color: var(--dim); }
  .index a { transition: color 300ms; }
  .index a::before { opacity: 0.35; transition: opacity 300ms, box-shadow 300ms; }
  .index a.on { color: var(--text); }
  .index a.on::before { opacity: 1; box-shadow: 0 0 10px rgba(var(--glow), 0.8); }

  .bottom { left: 15px; right: 15px; bottom: 15px; color: var(--muted); }
  .bottom .grow { position: relative; overflow: hidden; }
  .fill { position: absolute; inset: 0; background: rgba(var(--glow), 0.06); transform-origin: left; transform: scaleX(0); transition: transform 120ms linear; }
  .scroll { display: inline-flex; align-items: center; gap: 10px; position: relative; }
  .scroll i { width: 1px; height: 18px; background: linear-gradient(to bottom, transparent, var(--beam)); animation: drip 1.8s ease-in-out infinite; }
  @keyframes drip { 0% { transform: scaleY(0); transform-origin: top; } 50% { transform: scaleY(1); transform-origin: top; } 51% { transform-origin: bottom; } 100% { transform: scaleY(0); transform-origin: bottom; } }

  .copy { position: absolute; inset: 0; z-index: 2; display: grid; place-items: center; text-align: center; pointer-events: none; padding-top: 40vh; }
  .beat { grid-area: 1 / 1; opacity: 0; transform: translateY(14px); transition: opacity 700ms var(--ease), transform 900ms var(--ease); pointer-events: none; max-width: 760px; padding: 0 24px; }
  .beat.on { opacity: 1; transform: none; pointer-events: auto; }
  h1 { display: grid; gap: 4px; }
  .line-1 { font-size: clamp(40px, 5.4vw, 66px); font-weight: 500; letter-spacing: -0.02em; text-shadow: 0 2px 30px rgba(3, 10, 24, 0.7), 0 0 30px rgba(var(--glow), 0.14); }
  .line-2 { font-size: clamp(48px, 6.4vw, 78px); line-height: 1; padding: 0.06em 0.12em 0.22em; margin: -0.06em -0.12em -0.22em; text-shadow: 0 2px 30px rgba(3, 10, 24, 0.8), 0 0 40px rgba(var(--glow), 0.35); }
  .lead { margin-top: 26px; font-size: 17px; max-width: 54ch; margin-inline: auto; text-shadow: 0 1px 14px rgba(3, 10, 24, 0.8); }
  .beat :global(.wrap) { margin-top: 36px; text-shadow: 0 1px 14px rgba(3, 10, 24, 0.7); }
  .beat .bevel { margin-top: 36px; }

  @media (max-width: 800px) { .index, .bottom .dim { display: none; } .top { left: 24px; right: 24px; } }
</style>
