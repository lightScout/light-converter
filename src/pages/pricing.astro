---
import Base from '../layouts/Base.astro';
import Scene from '../components/Scene.astro';
---
<Base title="Pricing — Light Converter">
  <Scene mode="ambient" variant="prism" />
  <main style="min-height:100svh;display:grid;place-content:center;text-align:center;gap:16px">
    <h1><span class="display" style="font-size:64px">Everything runs on</span> <span class="accent" style="font-size:72px;margin-left:0.18em;padding:0 0.1em 0.2em;margin-bottom:-0.2em;display:inline-block">Light.</span></h1>
    <p class="muted">One Light is one clean cutout. 15 free every month.</p>
    <a class="cta" href="/" style="justify-self:center;margin-top:24px">Back</a>
  </main>
</Base>
