---
import Base from '../layouts/Base.astro';
import Scene from '../components/Scene.astro';
import Frame from '../components/Frame.astro';
import Star from '../components/Star.astro';
---
<Base title="Pricing — Light Converter">
  <Scene mode="ambient" variant="prism" />
  <Frame />
  <header class="hud top">
    <a href="/" class="brand"><Star size={16} color="var(--lavender)" /><span class="label" data-scramble>Light Converter</span></a>
    <nav>
      <a class="label" href="/" data-scramble>Landing</a>
      <a href="/app" class="bevel"><i class="glyph"></i><span data-scramble>Open app</span></a>
    </nav>
  </header>
  <main>
    <span class="label sq dim" data-scramble>Pricing</span>
    <h1><span class="display l1">Everything runs on</span> <span class="accent l2">Light.</span></h1>
    <p class="muted">One Light is one clean cutout. Fifteen free every month.</p>
    <dl class="spec">
      <div class="cross"><dt class="label dim">Free</dt><dd>15 Light / month · on your device</dd></div>
      <div class="cross"><dt class="label dim">Packs</dt><dd>100 Light · 500 Light · 2 000 Light</dd></div>
      <div class="cross"><dt class="label dim">Subscription</dt><dd>Unlimited server cutouts · priority queue</dd></div>
    </dl>
    <a class="bevel light" href="/app"><i class="glyph"></i>Start free</a>
  </main>
  <footer class="hud bottom cells">
    <span class="label dim" data-scramble>Failed images release their Light</span>
    <span class="grow"><span class="label dim" data-scramble>Stripe · packs and subscription</span></span>
    <span class="label dim" data-scramble>No watermark</span>
  </footer>
</Base>

<script>
  import { scrambleAll } from '../lib/scramble';
  document.addEventListener('astro:page-load', () => scrambleAll(document, 30));
</script>

<style>
  .hud { position: fixed; z-index: 6; }
  .top { top: 32px; left: 44px; right: 32px; display: flex; align-items: center; justify-content: space-between; }
  .brand { display: inline-flex; align-items: center; gap: 10px; }
  .brand .label { letter-spacing: 0.22em; font-weight: 600; }
  .top nav { display: flex; gap: 26px; align-items: center; color: var(--muted); }
  .bottom { left: 15px; right: 15px; bottom: 15px; color: var(--muted); }
  main { min-height: 100svh; display: grid; place-content: center; justify-items: center; text-align: center; gap: 18px; padding: 120px 24px; }
  .l1 { font-size: clamp(40px, 5vw, 64px); }
  .l2 { font-size: clamp(48px, 6vw, 72px); margin-left: 0.18em; padding: 0 0.1em 0.2em; margin-bottom: -0.2em; display: inline-block; }
  .spec { display: grid; gap: 14px; margin: 28px 0 8px; text-align: left; }
  .spec div { display: grid; grid-template-columns: 120px 1fr; gap: 24px; align-items: baseline; }
  dd { margin: 0; }
</style>
